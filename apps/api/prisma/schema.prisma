generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ARTISAN
  ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  role         Role
  phone        String     @unique
  email        String?    @unique
  passwordHash String
  isBanned     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  artisan      ArtisanProfile?
  requests     Request[]  @relation("ClientRequests")
  tokens       RefreshToken[]
}

model ArtisanProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  displayName    String
  bio            String
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  city           String
  neighborhood   String
  serviceAreas   String[]
  pricingNotes   String
  isAvailableNow Boolean  @default(false)
  ratingAvg      Float    @default(0)
  ratingCount    Int      @default(0)
  phone          String
  services       ArtisanService[]
  requests       Request[] @relation("ArtisanRequests")
  reviews        Review[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  services Service[]
  artisans ArtisanProfile[]
}

model Service {
  id         String    @id @default(uuid())
  name       String    @unique
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  artisans   ArtisanService[]
  requests   Request[]
}

model ArtisanService {
  id          String   @id @default(uuid())
  artisanId   String
  serviceId   String
  artisan     ArtisanProfile @relation(fields: [artisanId], references: [id])
  service     Service        @relation(fields: [serviceId], references: [id])

  @@unique([artisanId, serviceId])
}

model Request {
  id           String        @id @default(uuid())
  clientId     String
  artisanId    String
  serviceId    String
  city         String
  neighborhood String
  addressText  String
  desiredAt    DateTime
  detailsText  String
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())

  client       User           @relation("ClientRequests", fields: [clientId], references: [id])
  artisan      ArtisanProfile @relation("ArtisanRequests", fields: [artisanId], references: [id])
  service      Service        @relation(fields: [serviceId], references: [id])
  review       Review?
}

model Review {
  id         String   @id @default(uuid())
  requestId  String   @unique
  rating     Int
  comment    String
  createdAt  DateTime @default(now())

  request    Request  @relation(fields: [requestId], references: [id])
  artisan    ArtisanProfile? @relation(fields: [artisanId], references: [id])
  artisanId  String?
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}
